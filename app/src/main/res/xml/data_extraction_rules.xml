<?xml version="1.0" encoding="utf-8"?>
<!-- La conversación nunca se persiste ni se respalda (Ley 25.326). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
